6. select vendedor.nome_vendedor, pedido.valor_total from vendedor inner join pedido on vendedor.id_vendedor = pedido.id_vendedor inner join item_pedido on item_pedido.id_pedido = pedido.id_pedido 
 
7. SELECT 
    p.nome_produto, 
    SUM(ip.quantidade_item) AS mais_vendido 
FROM pedido ped 
INNER JOIN item_pedido ip 
    ON ped.id_pedido = ip.id_pedido 
INNER JOIN produto p 
    ON ip.id_produto = p.id_produto 
WHERE ped.status_pedido IN ('FATURADO', 'PAGO') 
GROUP BY p.id_produto, p.nome_produto 
ORDER BY mais vendido DESC; 
 
8. SELECT 
    c.id_cliente, 
    c.nome_cliente, 
    COUNT(p.id_pedido) AS quantidade_compras 
FROM cliente c 
INNER JOIN pedido p 
    ON c.id_cliente = p.id_cliente 
WHERE p.status_pedido IN ('FATURADO', 'PAGO') 
GROUP BY 
    c.id_cliente, 
    c.nome_cliente 
ORDER BY 
    quantidade compras DESC; 
 
